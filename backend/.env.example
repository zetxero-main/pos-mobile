# POS-MOBILE Backend Configuration

# App
APP_NAME=POS-MOBILE API
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite for local/Termux)
DATABASE_URL=sqlite+aiosqlite:///./pos_mobile.db
DATABASE_ECHO=false

# Server — 127.0.0.1 = รับเฉพาะเครื่องนี้ (AUTH ปิดเป็นค่าเริ่มต้น ถ้าใช้ 0.0.0.0
# ใครก็ได้ใน Wi-Fi เดียวกันจะอ่าน/แก้ข้อมูลร้านได้ — เปิด AUTH_ENABLED ก่อนเปลี่ยน)
HOST=127.0.0.1
PORT=8000

# Data directory (Termux/Android)
DATA_DIR=/data/data/com.termux/files/home/pos-mobile-data

# CORS Origins (for local file:// access)
# https://zetxero-main.github.io = หน้าเว็บบน GitHub Pages ที่กดสำรองข้อมูลมาที่ backend นี้
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "file://", "null", "https://zetxero-main.github.io"]

# Backup snapshots (POST /api/v1/sync/snapshots)
SNAPSHOT_KEEP=30
SNAPSHOT_MAX_BYTES=10000000